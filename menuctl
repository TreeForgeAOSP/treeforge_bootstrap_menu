from __future__ import annotations

import argparse
import hashlib
import io
import json
import lzma
import os
from pathlib import Path
import re
import shutil
import subprocess
import tarfile
from datetime import datetime

ROOT = Path(__file__).resolve().parent
VERSION_FILE = ROOT / "VERSION"
README = ROOT / "README.md"
MANIFEST = ROOT / "provider.json"
SUMS = ROOT / "SHA256SUMS"
RELEASE_ROOT = ROOT / "out" / "releases"
DEVELOPMENT_ROOT = ROOT / "out" / "development-provider"
DEVELOPMENT_RUNS = DEVELOPMENT_ROOT / "runs"
DEVELOPMENT_INCOMING = DEVELOPMENT_ROOT / ".incoming"
DEVELOPMENT_CURRENT = DEVELOPMENT_ROOT / "current"
DEVELOPMENT_RETENTION = 5
DEVELOPMENT_SCHEMA = "treeforge.development-provider.v1"
PROVIDER_NAME = "treeforge_bootstrap_menu"
PROVIDER_ABI = 1
VERSION_RE = re.compile(r"v1\.0b[0-9]+")

class ProviderError(RuntimeError):
    pass

def sha256(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as stream:
        for block in iter(lambda: stream.read(1024 * 1024), b""):
            digest.update(block)
    return digest.hexdigest()

def versions() -> dict[str,str]:
    if not VERSION_FILE.is_file():
        raise ProviderError(f"VERSION is missing: {VERSION_FILE}")
    out: dict[str,str] = {}
    for raw in VERSION_FILE.read_text(encoding="utf-8").splitlines():
        line=raw.strip()
        if not line or line.startswith("#"):
            continue
        if "=" not in line:
            raise ProviderError(f"invalid VERSION entry: {line!r}")
        k,v=line.split("=",1); k=k.strip(); v=v.strip()
        if not k or not v or k in out:
            raise ProviderError(f"invalid VERSION entry: {line!r}")
        out[k]=v
    required={"TREEFORGE_BOOT_MENU_VERSION","TREEFORGE_BOOT_MANAGER_VERSION","TREEFORGE_MENU_ABI"}
    if set(out)!=required:
        raise ProviderError(f"VERSION keys changed: {sorted(out)!r}")
    if VERSION_RE.fullmatch(out["TREEFORGE_BOOT_MENU_VERSION"]) is None:
        raise ProviderError("unsupported menu VERSION")
    if VERSION_RE.fullmatch(out["TREEFORGE_BOOT_MANAGER_VERSION"]) is None:
        raise ProviderError("unsupported Boot Manager VERSION")
    if out["TREEFORGE_MENU_ABI"] != str(PROVIDER_ABI):
        raise ProviderError("menu ABI changed")
    return out

def version() -> str:
    return versions()["TREEFORGE_BOOT_MENU_VERSION"]

def boot_manager_version() -> str:
    return versions()["TREEFORGE_BOOT_MANAGER_VERSION"]

def _read_manifest() -> dict[str,object]:
    try:
        data=json.loads(MANIFEST.read_text(encoding="utf-8"))
    except (OSError,json.JSONDecodeError) as e:
        raise ProviderError(f"invalid provider.json: {e}") from e
    if not isinstance(data,dict):
        raise ProviderError("provider.json is not an object")
    return data

def _write_manifest(data: dict[str,object]) -> None:
    MANIFEST.write_text(json.dumps(data,indent=2,sort_keys=True)+"\n",encoding="utf-8")

def manifest() -> dict[str,object]:
    data=_read_manifest(); v=versions()
    if data.get("schema_version")!=1: raise ProviderError("unsupported provider schema")
    if data.get("provider")!=PROVIDER_NAME: raise ProviderError("provider identity changed")
    if data.get("version")!=v["TREEFORGE_BOOT_MENU_VERSION"]: raise ProviderError("VERSION/provider mismatch")
    if data.get("abi")!=PROVIDER_ABI: raise ProviderError("menu ABI changed")
    components=data.get("component_versions")
    if not isinstance(components,dict) or components.get("boot_manager")!=v["TREEFORGE_BOOT_MANAGER_VERSION"]:
        raise ProviderError("Boot Manager VERSION/provider mismatch")
    return data

def expected_files(data: dict[str,object]):
    profile=data.get("profile"); userspace=data.get("userspace")
    if not isinstance(profile,dict) or not isinstance(userspace,dict):
        raise ProviderError("provider payload contract is incomplete")
    records=[("default_profile",profile.get("default"))]
    records.extend((name,userspace.get(name)) for name in ("core","ui","touch","controller"))
    for label,record in records:
        if not isinstance(record,dict): raise ProviderError(f"provider {label} contract is missing")
        path=record.get("path"); digest=record.get("sha256")
        if not isinstance(path,str) or not path: raise ProviderError(f"provider {label} path is invalid")
        if not isinstance(digest,str) or len(digest)!=64: raise ProviderError(f"provider {label} SHA256 is invalid")
        yield path,digest

def _sync_payload_hashes(data: dict[str,object]) -> None:
    profile=data["profile"]; userspace=data["userspace"]
    assert isinstance(profile,dict) and isinstance(userspace,dict)
    records=[profile["default"],userspace["core"],userspace["ui"],userspace["touch"],userspace["controller"]]
    for record in records:
        assert isinstance(record,dict); rel=record["path"]; assert isinstance(rel,str)
        path=ROOT/rel
        if not path.is_file(): raise ProviderError(f"missing provider payload: {rel}")
        record["sha256"]=sha256(path)

def _checksum_members(data: dict[str,object]) -> list[str]:
    members=[
        "VERSION",
        "README.md",
        "LICENSE",
        "LICENSES/Apache-2.0.txt",
        "provider.json",
        "menuctl",
        "tests/test_provider.py",
    ]
    members.extend(rel for rel,_ in expected_files(data))
    return sorted(set(members))

def _write_sums(data: dict[str,object]) -> None:
    lines=[]
    for rel in _checksum_members(data):
        p=ROOT/rel
        if not p.is_file(): raise ProviderError(f"checksum member is missing: {rel}")
        lines.append(f"{sha256(p)}  {rel}\n")
    SUMS.write_text("".join(lines),encoding="utf-8")

def sync() -> None:
    v=versions(); data=_read_manifest()
    data["version"]=v["TREEFORGE_BOOT_MENU_VERSION"]
    data["abi"]=PROVIDER_ABI
    data["component_versions"]={"boot_manager":v["TREEFORGE_BOOT_MANAGER_VERSION"]}
    _sync_payload_hashes(data); _write_manifest(data)
    lines=README.read_text(encoding="utf-8").splitlines()
    if not lines: raise ProviderError("README.md is empty")
    lines[0]=f"# TreeForge Bootstrap Menu — {v['TREEFORGE_BOOT_MENU_VERSION']}"
    README.write_text("\n".join(lines)+"\n",encoding="utf-8")
    _write_sums(data)
    print(f"VERSION={v['TREEFORGE_BOOT_MENU_VERSION']}")
    print(f"BOOT_MANAGER_VERSION={v['TREEFORGE_BOOT_MANAGER_VERSION']}")
    print("TREEFORGE_BOOTSTRAP_MENU_SYNC=PASS")

def _verify_sums() -> None:
    if not SUMS.is_file(): raise ProviderError("SHA256SUMS is missing")
    seen=set()
    for raw in SUMS.read_text(encoding="utf-8").splitlines():
        if not raw.strip(): continue
        try: digest,rel=raw.split("  ",1)
        except ValueError as e: raise ProviderError(f"invalid SHA256SUMS line: {raw!r}") from e
        if rel in seen: raise ProviderError(f"duplicate SHA256SUMS path: {rel}")
        seen.add(rel); p=ROOT/rel
        if not p.is_file(): raise ProviderError(f"SHA256SUMS path is missing: {rel}")
        actual=sha256(p)
        if actual!=digest: raise ProviderError(f"SHA256SUMS mismatch: {rel}\nexpected={digest}\nactual={actual}")
    expected=set(_checksum_members(manifest()))
    if seen!=expected: raise ProviderError(f"SHA256SUMS membership changed: expected={sorted(expected)!r} actual={sorted(seen)!r}")

def _verify_readme_version() -> None:
    current=version(); text=README.read_text(encoding="utf-8"); lines=text.splitlines()
    if not lines or lines[0] != f"# TreeForge Bootstrap Menu — {current}": raise ProviderError("README title does not match VERSION")
    self_versions=VERSION_RE.findall(text)
    if self_versions != [current]: raise ProviderError("README must contain exactly one component version, in the title")

def verify() -> None:
    data=manifest(); _verify_readme_version(); _verify_sums()
    for rel,expected in expected_files(data):
        p=ROOT/rel
        if not p.is_file(): raise ProviderError(f"missing provider file: {rel}")
        actual=sha256(p)
        if actual!=expected: raise ProviderError(f"SHA256 mismatch: {rel}\nexpected={expected}\nactual={actual}")
    userspace=data["userspace"]; profile=data["profile"]
    assert isinstance(userspace,dict) and isinstance(profile,dict)
    markers={
        "core":["TFB_ACTION_BOOT_ANDROID_SLOT_A","struct tfb_menu_page","__TREEFORGE_MENU_PROFILE__"],
        "ui":["static int tfb_ui_landscape_supported(","static void tfb_fb_render_menu(","TFB_BUFFERED_MENU_PRESENT_V1"],
        "touch":["static void tfb_touch_reset_state(","static int tfb_menu_touch_row(","static int tfb_touch_process_event("],
        "controller":["static void tfb_menu_activate_selected(","static void tfb_run_menu(void)"],
    }
    for name,needles in markers.items():
        record=userspace[name]; assert isinstance(record,dict); rel=record["path"]; assert isinstance(rel,str)
        text=(ROOT/rel).read_text(encoding="utf-8")
        for needle in needles:
            if needle not in text: raise ProviderError(f"{name} marker missing: {needle}")
    default=profile["default"]; assert isinstance(default,dict); rel=default["path"]; assert isinstance(rel,str)
    pdata=json.loads((ROOT/rel).read_text(encoding="utf-8"))
    if pdata.get("schema")!=1 or pdata.get("profile_id")!="treeforge-default": raise ProviderError("default menu profile identity changed")
    v=versions()
    print(f"PROVIDER={PROVIDER_NAME}")
    print(f"VERSION={v['TREEFORGE_BOOT_MENU_VERSION']}")
    print(f"BOOT_MANAGER_VERSION={v['TREEFORGE_BOOT_MANAGER_VERSION']}")
    print(f"ABI={PROVIDER_ABI}")
    print("VERSION_SOURCE=VERSION")
    print("README_VERSION_AUDIT=PASS")
    print("MENU_PROFILE=PASS")
    print("MENU_RUNTIME_FRAGMENTS=PASS")
    print("TREEFORGE_BOOTSTRAP_MENU_VERIFY=PASS")

def _archive_members(data: dict[str,object]) -> list[str]:
    return sorted(set(_checksum_members(data)+["SHA256SUMS"]))


def _run_id() -> str:
    return datetime.now().astimezone().strftime(
        "%Y%m%d-%H%M%S-%f%z"
    )


def _git_source() -> tuple[str, bool, str | None]:
    commit_result = subprocess.run(
        ["git", "rev-parse", "HEAD"],
        cwd=ROOT,
        text=True,
        capture_output=True,
        check=False,
    )

    if commit_result.returncode != 0:
        raise ProviderError(
            "unable to resolve source commit"
        )

    status_result = subprocess.run(
        [
            "git",
            "status",
            "--porcelain",
            "--untracked-files=all",
        ],
        cwd=ROOT,
        text=True,
        capture_output=True,
        check=False,
    )

    if status_result.returncode != 0:
        raise ProviderError(
            "unable to resolve source worktree state"
        )

    remote_result = subprocess.run(
        [
            "git",
            "config",
            "--get",
            "remote.origin.url",
        ],
        cwd=ROOT,
        text=True,
        capture_output=True,
        check=False,
    )

    remote = (
        remote_result.stdout.strip()
        if remote_result.returncode == 0
        and remote_result.stdout.strip()
        else None
    )

    return (
        commit_result.stdout.strip(),
        bool(status_result.stdout.strip()),
        remote,
    )


def _verify_development_provider(
    root: Path,
) -> dict[str, object]:
    manifest_path = (
        root
        / "development-provider.json"
    )

    if not manifest_path.is_file():
        raise ProviderError(
            "development-provider.json is missing"
        )

    try:
        development = json.loads(
            manifest_path.read_text(
                encoding="utf-8"
            )
        )
    except (
        OSError,
        json.JSONDecodeError,
    ) as error:
        raise ProviderError(
            "invalid development-provider.json"
        ) from error

    if not isinstance(
        development,
        dict,
    ):
        raise ProviderError(
            "development-provider.json is not an object"
        )

    if (
        development.get("schema")
        != DEVELOPMENT_SCHEMA
        or development.get("provider")
        != PROVIDER_NAME
        or development.get("channel")
        != "development"
        or development.get("release_eligible")
        is not False
    ):
        raise ProviderError(
            "development provider identity changed"
        )

    provider_path = root / "provider.json"

    try:
        data = json.loads(
            provider_path.read_text(
                encoding="utf-8"
            )
        )
    except (
        OSError,
        json.JSONDecodeError,
    ) as error:
        raise ProviderError(
            "development provider.json is invalid"
        ) from error

    if not isinstance(data, dict):
        raise ProviderError(
            "development provider.json is not an object"
        )

    if (
        data.get("provider")
        != PROVIDER_NAME
        or data.get("schema_version")
        != 1
        or data.get("abi")
        != PROVIDER_ABI
        or data.get("version")
        != development.get("version")
    ):
        raise ProviderError(
            "development provider contract changed"
        )

    sums_path = root / "SHA256SUMS"

    if not sums_path.is_file():
        raise ProviderError(
            "development SHA256SUMS is missing"
        )

    seen: set[str] = set()

    for raw in sums_path.read_text(
        encoding="utf-8"
    ).splitlines():
        if not raw.strip():
            continue

        try:
            digest, relative = raw.split(
                "  ",
                1,
            )
        except ValueError as error:
            raise ProviderError(
                "invalid development "
                f"SHA256SUMS line: {raw!r}"
            ) from error

        if relative in seen:
            raise ProviderError(
                "duplicate development checksum: "
                f"{relative}"
            )

        seen.add(relative)

        path = root / relative

        if not path.is_file():
            raise ProviderError(
                "development provider file missing: "
                f"{relative}"
            )

        actual = sha256(path)

        if actual != digest:
            raise ProviderError(
                "development checksum mismatch: "
                f"{relative}"
            )

    expected = set(
        _checksum_members(data)
    )

    if seen != expected:
        raise ProviderError(
            "development checksum membership changed"
        )

    for relative, expected_digest in expected_files(
        data
    ):
        path = root / relative

        if not path.is_file():
            raise ProviderError(
                "development payload missing: "
                f"{relative}"
            )

        if sha256(path) != expected_digest:
            raise ProviderError(
                "development payload checksum mismatch: "
                f"{relative}"
            )

    return development


def _update_current(
    run: Path,
) -> None:
    temporary = (
        DEVELOPMENT_ROOT
        / ".current.tmp"
    )

    if (
        temporary.exists()
        or temporary.is_symlink()
    ):
        temporary.unlink()

    temporary.symlink_to(
        Path("runs")
        / run.name,
        target_is_directory=True,
    )

    os.replace(
        temporary,
        DEVELOPMENT_CURRENT,
    )


def _prune_development_runs(
    current_run: Path,
) -> None:
    runs = sorted(
        (
            path
            for path in DEVELOPMENT_RUNS.iterdir()
            if path.is_dir()
        ),
        key=lambda path: path.name,
        reverse=True,
    )

    keep = [current_run]

    for path in runs:
        if path == current_run:
            continue

        if len(keep) >= DEVELOPMENT_RETENTION:
            break

        keep.append(path)

    keep_resolved = {
        path.resolve()
        for path in keep
    }

    for path in runs:
        if path.resolve() in keep_resolved:
            continue

        shutil.rmtree(path)


def build() -> Path:
    sync()
    verify()

    data = manifest()

    DEVELOPMENT_ROOT.mkdir(
        parents=True,
        exist_ok=True,
    )

    DEVELOPMENT_RUNS.mkdir(
        parents=True,
        exist_ok=True,
    )

    DEVELOPMENT_INCOMING.mkdir(
        parents=True,
        exist_ok=True,
    )

    run_id = _run_id()

    staged = (
        DEVELOPMENT_INCOMING
        / run_id
    )

    final = (
        DEVELOPMENT_RUNS
        / run_id
    )

    if staged.exists() or final.exists():
        raise ProviderError(
            f"development run already exists: {run_id}"
        )

    staged.mkdir(
        parents=True,
    )

    try:
        for relative in _archive_members(data):
            source = ROOT / relative
            destination = staged / relative

            destination.parent.mkdir(
                parents=True,
                exist_ok=True,
            )

            shutil.copy2(
                source,
                destination,
            )

        source_commit, source_dirty, repository = (
            _git_source()
        )

        development = {
            "schema":
                DEVELOPMENT_SCHEMA,

            "provider":
                PROVIDER_NAME,

            "channel":
                "development",

            "release_eligible":
                False,

            "version":
                data["version"],

            "abi":
                PROVIDER_ABI,

            "run_id":
                run_id,

            "source_commit":
                source_commit,

            "source_dirty":
                source_dirty,

            "repository":
                repository,

            "retention_successful_runs":
                DEVELOPMENT_RETENTION,
        }

        if "component_versions" in data:
            development["component_versions"] = (
                data["component_versions"]
            )

        (
            staged
            / "development-provider.json"
        ).write_text(
            json.dumps(
                development,
                indent=2,
                sort_keys=True,
            )
            + "\n",
            encoding="utf-8",
        )

        _verify_development_provider(
            staged
        )

        staged.replace(
            final
        )

    except Exception:
        if staged.exists():
            shutil.rmtree(
                staged
            )

        raise

    _update_current(
        final
    )

    _prune_development_runs(
        final
    )

    print(
        f"RUN={final}"
    )
    print(
        f"CURRENT={DEVELOPMENT_CURRENT}"
    )
    print(
        f"RETAINED={DEVELOPMENT_RETENTION}"
    )
    print(
        f"{PROVIDER_NAME.upper()}_DEVELOPMENT_PROVIDER=PASS"
    )

    return final


def package() -> Path:
    if not DEVELOPMENT_CURRENT.exists():
        raise ProviderError(
            "development provider is missing; "
            "run ./menuctl build first"
        )

    provider_root = (
        DEVELOPMENT_CURRENT
        .resolve(
            strict=True
        )
    )

    development = (
        _verify_development_provider(
            provider_root
        )
    )

    if development.get(
        "source_dirty"
    ) is not False:
        raise ProviderError(
            "development provider source is dirty"
        )

    data = json.loads(
        (
            provider_root
            / "provider.json"
        ).read_text(
            encoding="utf-8"
        )
    )

    current_version = str(
        data["version"]
    )

    if (
        development.get("version")
        != current_version
    ):
        raise ProviderError(
            "development/provider version mismatch"
        )

    release_dir = (
        RELEASE_ROOT
        / current_version
        / "assets"
    )

    if (
        release_dir.exists()
        and any(
            release_dir.iterdir()
        )
    ):
        raise ProviderError(
            "release assets already exist; "
            "use ./release prepare --force"
        )

    release_dir.mkdir(
        parents=True,
        exist_ok=True,
    )

    name = (
        "treeforge-bootstrap-menu-"
        f"{current_version}-provider.tar.xz"
    )

    destination = (
        release_dir
        / name
    )

    sidecar = (
        release_dir
        / f"{name}.sha256"
    )

    prefix = PROVIDER_NAME

    epoch = int(
        os.environ.get(
            "SOURCE_DATE_EPOCH",
            "0",
        )
    )

    with lzma.open(
        destination,
        "wb",
        format=lzma.FORMAT_XZ,
        preset=9,
    ) as xz:
        with tarfile.open(
            fileobj=xz,
            mode="w",
            format=tarfile.PAX_FORMAT,
        ) as bundle:
            for relative in _archive_members(
                data
            ):
                path = (
                    provider_root
                    / relative
                )

                raw = path.read_bytes()

                info = tarfile.TarInfo(
                    f"{prefix}/{relative}"
                )

                info.size = len(raw)
                info.mtime = epoch
                info.uid = 0
                info.gid = 0
                info.uname = ""
                info.gname = ""

                info.mode = (
                    0o755
                    if relative
                    == "menuctl"
                    else 0o644
                )

                bundle.addfile(
                    info,
                    io.BytesIO(raw),
                )

    digest = sha256(
        destination
    )

    sidecar.write_text(
        f"{digest}  {name}\n",
        encoding="utf-8",
    )

    shutil.copy2(
        provider_root
        / "provider.json",
        release_dir
        / "provider.json",
    )

    shutil.copy2(
        provider_root
        / "SHA256SUMS",
        release_dir
        / "SHA256SUMS",
    )

    print(
        f"VERSION={current_version}"
    )

    print(
        f"DEVELOPMENT_RUN={provider_root}"
    )

    print(
        f"RELEASE_DIR={release_dir}"
    )

    print(
        f"ARCHIVE={destination}"
    )

    print(
        f"BYTES={destination.stat().st_size}"
    )

    print(
        f"SHA256={digest}"
    )

    print(
        "TREEFORGE_BOOTSTRAP_MENU_PACKAGE=PASS"
    )

    return destination


def main() -> None:
    parser = argparse.ArgumentParser(
        prog="menuctl"
    )

    parser.add_argument(
        "command",
        choices=(
            "sync",
            "verify",
            "build",
            "package",
        ),
    )

    args = parser.parse_args()

    try:
        if args.command == "sync":
            sync()
        elif args.command == "verify":
            verify()
        elif args.command == "build":
            build()
        else:
            package()

    except ProviderError as error:
        parser.error(
            str(error)
        )


if __name__=="__main__": main()
